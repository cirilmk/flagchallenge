<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HeaderTextViewStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TimeBoxStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:background">@drawable/bg_time_box</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/colorOnSecondary</item>
    </style>

    <style name="OptionButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_option_default</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/black</item>
        <!-- Disable Material default filled background -->
        <item name="backgroundTint">@null</item>
    </style>

</resources>