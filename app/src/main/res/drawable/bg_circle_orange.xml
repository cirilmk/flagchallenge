<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Size of the circle -->
    <size
        android:width="28dp"
        android:height="28dp" />

    <!-- Figma Orange Accent -->
    <solid android:color="@color/colorPrimary" />

    <!-- Optional subtle shadow/glow (if your Figma shows it) -->
    <stroke
        android:width="1dp"
        android:color="#CCFFFFFF" /> <!-- semi-transparent white outline -->

</shape>